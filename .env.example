GRAPH_KEY={"tenant_id":"...","client_id":"...","client_secret":"..."}

# MODO RECOMENDADO: resolver la carpeta directamente desde su URL compartida.
# Evita la llamada Graph /sites/{hostname}:/{path} que exige permisos Sites.*.
SHAREPOINT_FOLDER_URL=https://ruesma.sharepoint.com/:f:/r/sites/it/Documentos%20compartidos/albaranes?csf=1&web=1&e=Clgiac

# MODO LEGACY (solo si no usas SHAREPOINT_FOLDER_URL)
SHAREPOINT_HOSTNAME=ruesma.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/it
SHAREPOINT_DRIVE_NAME=Documentos compartidos
SHAREPOINT_DRIVE_ID=

# Ruta lógica que se guarda en la BBDD. Para el modo SHAREPOINT_FOLDER_URL,
# la subida real cuelga de la carpeta resuelta por la URL.
SHAREPOINT_FOLDER_ROOT=albaranes
SHAREPOINT_LINK_TYPE=view
SHAREPOINT_LINK_SCOPE=organization
SHAREPOINT_CREATE_LINK=true

PG_HOST=localhost
PG_PORT=5432
PG_DB=albaranes
PG_USER=postgres
PG_PASSWORD=admin

PG_ADMIN_DB=postgres
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=admin

API_HOST=127.0.0.1
API_PORT=8001
HTTP_TIMEOUT_S=60
LOG_LEVEL=INFO
LOG_DIR=logs
SERVICE_VERSION=1.0.0
